# --- Required ---
COCOINDEX_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/seek

# --- Optional overrides (uncomment to change) ---

# Root directory to index (default: C:/Projects)
# SEEK_PROJECTS_PATH=C:/Projects

# Sentence-transformers model name (must match at index + search time)
# SEEK_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunk size in characters (default: 500)
# SEEK_CHUNK_SIZE=500

# Chunk overlap in characters (default: 100)
# SEEK_CHUNK_OVERLAP=100

# Default number of search results (default: 5)
# SEEK_TOP_K=5
